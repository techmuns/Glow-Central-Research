{
  // MUST match the deployed Worker: https://sattva-central-research.tech-441.workers.dev.
  // This said "sattva-central" while the live Worker was "sattva-central-research", so
  // `npx wrangler deploy` would have created a SECOND, empty Worker beside the real one, and
  // `npx wrangler secret put MUNS_TOKEN` would have put the credential on that empty one — where
  // nothing reads it, and where it would look like it had been set correctly.
  "name": "sattva-central-research",
  "compatibility_date": "2026-05-23",
  "main": "worker/index.js",
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // WHICH REPOSITORY THE NEWS REFRESH BUTTON MAY START A RUN IN.
  //
  // Not a secret — it is the public name of a public repository, and it is here rather than in the
  // request precisely so nobody who finds `POST /api/market-news/refresh` can point it somewhere
  // else. The credential that goes with it is NOT here and never should be:
  //
  //     npx wrangler secret put GH_DISPATCH_TOKEN     # production
  //     echo 'GH_DISPATCH_TOKEN=github_pat_…' >> .dev.vars   # local, gitignored
  //
  // A fine-grained personal access token scoped to this ONE repository with a single permission,
  // "Actions: read and write". Nothing else — it does not need contents, and a token that can
  // write code is not the token to hand an unauthenticated route.
  "vars": {
    "GH_REPO": "techmuns/Sattva-Central-Research",
    "GH_REF": "main"
  },

  // THE NEWS CADENCE COMES FROM HERE, NOT FROM GITHUB'S `schedule:` BLOCK.
  //
  // Measured on this repository: a GitHub `*/20 * * * *` cron fired 12 times against 124 scheduled
  // over 41 hours, and after being relaxed to `*/30` across a 12-hour window it fired ZERO times
  // against ~11 scheduled in the next 5.7 hours. Their scheduler is best-effort and this repo is at
  // the back of the queue. `workflow_dispatch`, by contrast, started a run within SECONDS on every
  // one of six dispatches the same day.
  //
  // So a scheduler that works drives the trigger that works: this cron wakes the Worker, and
  // `scheduled()` in worker/index.js dispatches market-news-refresh.yml. It ticks every 20 minutes
  // and the handler drops to hourly outside the window the publisher answers in — see the comment
  // there for both measurements. GitHub's own `schedule:` block stays as a fallback for a
  // deployment that has no Worker.
  "triggers": {
    "crons": ["*/20 * * * *"]
  }
}
