{
  // MUST match the deployed Worker: https://glow-central-research.tech-441.workers.dev.
  // A name that does not match the live Worker is a quiet trap rather than a loud one:
  // `npx wrangler deploy` would create a SECOND, empty Worker beside the real one, and
  // `npx wrangler secret put MUNS_TOKEN` would put the credential on that empty one — where
  // nothing reads it, and where it would look like it had been set correctly.
  "name": "glow-central-research",
  "compatibility_date": "2026-05-23",
  "main": "worker/index.js",
  "assets": { "directory": "./public", "binding": "ASSETS" }
}
